# ── Configuración de Contenedores ──────────────────────────────────────────────
PHP_CONTAINER=orthoshoefix_app
NGINX_CONTAINER=orthoshoefix_nginx
MARIADB_CONTAINER=orthoshoefix_db
REDIS_CONTAINER=orthoshoefix_redis

# ── Base de datos ──────────────────────────────────────────────────────────────
DB_DATABASE=orthoshoefix
DB_USERNAME=orthoshoefix
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame_tambien

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cambiame_igual

# ── Red ──────────────────────────────────────────────────────────────────────
DOCKER_NETWORK_NAME=orthoshoefix_network


# ── Puertos publicados en el host (solo en 127.0.0.1) ─────────────────────────
# Nginx NO usa el 80: ese lo tiene el reverse proxy del host.
NGINX_PORT=8081
MARIADB_PORT=33061
